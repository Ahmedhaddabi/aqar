// Starter knowledge-base articles taken from the Aqar 360 strategy (V10). Runs only when the knowledge base is empty;
// every article stays editable in Admin → Knowledge base. Usage: npm run db:seed-kb
import { count } from "drizzle-orm";
import { drizzle } from "drizzle-orm/postgres-js";
import postgres from "postgres";

import { kbArticles } from "../src/db/schema";

const client = postgres(process.env.DATABASE_URL!, { prepare: false, max: 1 });
const db = drizzle(client);

const ARTICLES: { title: string; category: string; body: string }[] = [
  { title: "أهداف زمن الخدمة (SLA)", category: "procedure", body: `الرد على طلب جديد: خلال 1–2 ساعة عمل (العميل المحتمل الجديد: 15–30 دقيقة أثناء الدوام).
مراجعة فرصة مالك: في نفس يوم العمل.
تأكيد موعد التصوير: خلال 4 ساعات عمل.
صور احترافية: 24 ساعة بعد التصوير.
مخطط المساحات: 24–48 ساعة.
فيديو قياسي: 48 ساعة.
فيديو بالذكاء الاصطناعي: 48–72 ساعة.
درون + ذكاء اصطناعي: 72 ساعة.
فيديو بمقدم: 3 أيام عمل.
فيديو لايف ستايل: 5 أيام عمل.
تعديل بسيط: 24 ساعة.
إطلاق حملة بعد الاعتماد: 4 ساعات عمل.

الحالات: جديد → مسند → قيد التنفيذ → بانتظار العميل → مراجعة → مكتمل.
عند «بانتظار العميل» يتوقف عداد الوقت. النظام يلوّن الأعمال: أخضر في الوقت، برتقالي معرض للتأخير، أحمر متأخر، ويرسل تنبيها يوميا للمسؤول والمدير.` },
  { title: "أسعار الخدمات المعتمدة", category: "prices", body: `صور احترافية (10 صور مختارة ومعدلة): 120 ر.ع
مخطط المساحات 2D: 100 ر.ع
فيديو قياسي (تصوير + مونتاج + تعليق صوتي + ترجمة + موسيقى): 150 ر.ع
فيديو بالذكاء الاصطناعي: 180 ر.ع
درون + فيديو ذكاء اصطناعي (حسب التصاريح والموقع والطقس): 250 ر.ع
فيديو بمقدم: 300 ر.ع
فيديو لايف ستايل: 600 ر.ع

• كل خدمة مستقلة؛ لا توجد باقة فيديو إجبارية.
• العقارات الكبيرة والمشاريع والنطاق غير المعتاد: عرض سعر خاص.
• عدد جولات التعديل يظهر في شروط الخدمة (الافتراضي جولتان).
• الجدولة تبدأ بعد اكتمال متطلبات الطلب والدفع — النظام ينشئ العمل تلقائيا عند الدفع ويطلب التفاصيل من العميل.` },
  { title: "مراجعة فرص الملاك (قائمة التحقق)", category: "procedure", body: `قبل القبول تحقق من:
1. واقعية السعر مقارنة بالطلب الحالي في السوق.
2. جودة العقار وقابليته للتصوير والتسويق.
3. الموقع ضمن نطاق خدمتنا.
4. توثيق الملكية أو التفويض قبل أي نشر أو حملة (ارفعه في «المستندات» على الطلب).
5. العائد التجاري وقدرتنا التشغيلية الآن.

بعد القبول: اختر «محتوى فقط» أو «تسويق العقار». النظام ينشئ عقارا مسودة غير منشور؛ أكمل البيانات والصور ثم فعّل «إظهار في الموقع».
عند عدم الاختيار: اختر السبب الداخلي وأرسل الرسالة اللطيفة. لا تذكر السبب الداخلي للعميل.

تنبيه قانوني: لا نستخدم عبارة «عمولة وساطة» (Brokerage Commission) ما لم يصدر الترخيص المناسب. نصف دورنا بدقة: تسويق، إنتاج محتوى، استقطاب عملاء، إحالة.` },
  { title: "قواعد التواصل وعدم الإزعاج", category: "policy", body: `• الموافقة مستقلة لكل غرض وقناة: تحديثات الطلب ≠ تنبيهات العقارات ≠ التسويق.
• رسالة متابعة عامة واحدة كل 7–14 يوما كحد أقصى عند الحاجة.
• إيقاف التنبيهات فوري عند طلب العميل أو إغلاق الطلب.
• واتساب: نرسل فقط لمن اختاره ووافق عليه؛ الرسائل الاستباقية تخضع لسياسات Meta.
• لا نرسل عقارا للعميل قبل مراجعته واعتماده من الفريق، ولا نكشف اسم المطور أو مصادرنا الداخلية.
• عند تسجيل طلب من مكالمة: علّم القنوات التي وافق عليها العميل فعلا.` },
  { title: "أموال الإعلانات المدفوعة (فصل الأموال)", category: "policy", body: `ميزانية الإعلانات التي يدفعها العميل للحملات ليست إيرادا للشركة.
عند إنشاء الفاتورة أضفها كبند منفصل وضع علامة «أموال إعلانية للعميل».
النظام يعرضها منفصلة في الملخص المالي حتى لا يتضخم الإيراد ويبقى هامش الربح صحيحا.` },
  { title: "الاسترداد والموافقات", category: "policy", body: `• أي استرداد يُطلب من صفحة الفاتورة ويحتاج موافقة المدير العام (Admin)، ولا يوافق أحد على طلبه بنفسه.
• بعد الموافقة يُسجل الاسترداد ويُصدر «إشعار دائن» للعميل من رابط الإيصال.
• مطالبات المصروفات: الموظف يرفع الإيصال، المدير يعتمد، ثم «تم الصرف» يسجل المصروف تلقائيا.
• كل القرارات تظهر في «الموافقات» وتُحفظ في سجل النشاط.` },
  { title: "الرد على طلب جديد خطوة بخطوة", category: "procedure", body: `1. افتح «الطلبات» → «جديدة» (الأحمر تجاوز وقت الرد).
2. اضغط «أخذه» ليصبح الطلب مسندا لك.
3. اتصل بالعميل أو راسله عبر واتساب من الزر في الصفحة.
4. سجّل ما حدث في «السجل» وغيّر الحالة إلى «تم التواصل».
5. راجع «العقارات المقترحة»: اعتمد المناسب وأرسله، أو احجز معاينة.
6. لكل معاينة سجّل النتيجة: مهتم، لا يناسب، يريد بدائل.
للمكالمات والزيارات المباشرة استخدم «عميل / طلب جديد» حتى لا يضيع أي عميل.` },
];

const [{ n }] = await db.select({ n: count() }).from(kbArticles);
if (n > 0) {
  console.log(`knowledge base already has ${n} articles; nothing added`);
} else {
  await db.insert(kbArticles).values(ARTICLES);
  console.log(`added ${ARTICLES.length} starter articles`);
}
await client.end();
