# Copy to .env.local. Server-only values never reach the browser.

# Frappe backend reached from the Next.js server (never from the browser).
FRAPPE_URL=http://127.0.0.1:8080
# Frappe site name; sent as the Host header so the right site answers.
FRAPPE_SITE=staging.localhost

# Public site address used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Customer-provided values (see aqar360/docs/customer_inputs.md). Leave empty until known.
NEXT_PUBLIC_COMPANY_NAME_AR=عقار 360
NEXT_PUBLIC_COMPANY_NAME_EN=Aqar 360
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
# Google Tag Manager container; analytics loads only after the visitor consents.
NEXT_PUBLIC_GTM_ID=
# Cloudflare Turnstile site key (the secret goes in Frappe site_config as aqar_turnstile_secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Map style URL (MapLibre vector style). Default: OpenFreeMap (free, no key). For production a provider such as
# MapTiler: https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY (its origin is allowed in the CSP).
NEXT_PUBLIC_MAP_STYLE_URL=

# Outside services (email, Thawani, Paymob, WhatsApp, AI): the admin normally enters these in Admin → Integrations, where
# secrets are stored encrypted with AUTH_SECRET (changing AUTH_SECRET means re-entering them). The variables below are a
# fallback only; a service saved in Integrations ignores them.
# Email (Resend).
RESEND_API_KEY=
MAIL_FROM=

# Online payments (docs/runbooks/payments_setup.md). Leave empty until the gateway accounts exist; the pay buttons stay hidden.
# Thawani: keys from the Thawani merchant portal. THAWANI_MODE=test uses uatcheckout.thawani.om, live uses checkout.thawani.om.
THAWANI_MODE=test
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
# Paymob Oman: Dashboard → Settings → Account info (secret key, public key, HMAC secret); Developers → Payment integrations (IDs).
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated integration IDs, e.g. card and OmanNet: 12345,67890
PAYMOB_INTEGRATION_IDS=
# Defaults for Oman; change only if Paymob tells you otherwise.
PAYMOB_BASE_URL=https://oman.paymob.com
PAYMOB_CHECKOUT_URL=https://om.checkout.paymob.com
# Amount sent = OMR × factor (Paymob counts in the smallest unit: 1 OMR = 1000 baisa). Confirm with the first test payment.
PAYMOB_AMOUNT_FACTOR=1000

# WhatsApp Business (Meta Cloud API) — docs/runbooks/whatsapp_ai_setup.md. Empty = WhatsApp off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# AI (Claude, Anthropic API) — empty = AI features hidden. AI_MODEL defaults to claude-opus-5-5; AI_PER_HOUR (default 60)
# limits AI requests per staff member per hour.
ANTHROPIC_API_KEY=
AI_MODEL=
AI_PER_HOUR=
