{
 "doctype": "DocType",
 "name": "Aqar Content Deliverable",
 "module": "Aqar 360",
 "engine": "InnoDB",
 "sort_field": "creation",
 "sort_order": "DESC",
 "istable": 1,
 "editable_grid": 1,
 "permissions": [],
 "field_order": [
  "service_item",
  "deliverable_type",
  "file",
  "version",
  "status",
  "uploaded_on",
  "note"
 ],
 "fields": [
  {
   "fieldname": "service_item",
   "fieldtype": "Link",
