   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "deliverable_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Photos\nFloor Plan\nVideo\nOther",
   "in_list_view": 1
  },
  {
   "fieldname": "file",
   "fieldtype": "Attach",
   "label": "File",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "version",
   "fieldtype": "Int",
   "label": "Version",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Client Status",
   "options": "Uploaded\nClient Approved\nChanges Requested",
   "default": "Uploaded",
   "in_list_view": 1
  },
  {
   "fieldname": "uploaded_on",
   "fieldtype": "Datetime",
   "label": "Uploaded On",
   "read_only": 1
  },
  {
   "fieldname": "note",
   "fieldtype": "Small Text",
   "label": "Note"
  }
 ]
}
