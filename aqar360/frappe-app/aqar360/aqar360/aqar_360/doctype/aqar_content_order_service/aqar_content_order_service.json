{
 "doctype": "DocType",
 "name": "Aqar Content Order Service",
 "module": "Aqar 360",
 "engine": "InnoDB",
 "sort_field": "creation",
 "sort_order": "DESC",
 "istable": 1,
 "editable_grid": 1,
 "permissions": [],
 "field_order": [
  "item",
  "item_name",
  "description",
  "qty",
  "rate",
  "amount",
  "sla_policy",
  "revision_rounds",
  "ready_for_review"
 ],
 "fields": [
  {
   "fieldname": "item",
   "fieldtype": "Link",
   "label": "Service",
   "options": "Item",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "item_name",
   "fieldtype": "Data",
   "label": "Service Name",
   "read_only": 1,
   "fetch_from": "item.item_name"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Scope",
   "fetch_from": "item.description",
   "fetch_if_empty": 1
  },
  {
   "fieldname": "qty",
   "fieldtype": "Float",
   "label": "Qty",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "rate",
   "fieldtype": "Currency",
   "label": "Rate (OMR)",
   "in_list_view": 1,
   "description": "Filled from the price list when empty.",
   "precision": "3"
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount (OMR)",
   "read_only": 1,
   "in_list_view": 1,
   "precision": "3"
  },
  {
   "fieldname": "sla_policy",
   "fieldtype": "Link",
   "label": "Delivery SLA",
   "read_only": 1,
   "options": "Aqar SLA Policy",
   "fetch_from": "item.custom_aqar_sla_policy"
  },
  {
   "fieldname": "revision_rounds",
   "fieldtype": "Int",
   "label": "Included Revisions",
   "read_only": 1,
   "fetch_from": "item.custom_aqar_revision_rounds"
  },
  {
   "fieldname": "ready_for_review",
   "fieldtype": "Check",
   "label": "Ready for Review",
   "read_only": 1,
   "in_list_view": 1
  }
 ]
}
