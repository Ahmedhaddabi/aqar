{
 "doctype": "DocType",
 "name": "Aqar Document",
 "module": "Aqar 360",
 "engine": "InnoDB",
 "autoname": "format:DOC-{YYYY}-{#####}",
 "title_field": "title",
 "track_changes": 1,
 "sort_field": "creation",
 "sort_order": "DESC",
 "search_fields": "title,document_type,classification",
 "field_order": [
  "title",
  "classification",
  "document_type",
  "file",
  "col_a",
  "contact",
  "property",
  "project",
  "content_order",
  "retain_until",
  "checks_section",
  "scan_status",
  "sha256",
  "col_b",
  "file_size",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "classification",
   "fieldtype": "Select",
   "label": "Classification",
   "reqd": 1,
   "default": "Confidential",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Public\nInternal\nConfidential\nHighly Restricted",
   "description": "Highly Restricted (IDs, bank details, financial contracts) is visible only to managers, finance and admins."
  },
  {
   "fieldname": "document_type",
   "fieldtype": "Select",
   "label": "Document Type",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Identity Document\nOwnership / Title Deed\nAuthorisation\nContract\nQuotation\nInvoice / Receipt\nPermit\nReport\nBrochure\nFloor Plan\nPhoto\nOther"
  },
  {
   "fieldname": "file",
   "fieldtype": "Attach",
   "label": "File",
   "reqd": 1,
   "description": "Upload as a private file."
  },
  {
   "fieldname": "col_a",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "contact",
   "fieldtype": "Link",
   "label": "Customer / Person",
   "options": "Contact",
   "in_standard_filter": 1
  },
  {
   "fieldname": "property",
   "fieldtype": "Link",
   "label": "Property",
   "options": "Property",
   "in_standard_filter": 1
  },
  {
   "fieldname": "project",
   "fieldtype": "Link",
   "label": "Project",
   "options": "Aqar Development Project"
  },
  {
   "fieldname": "content_order",
   "fieldtype": "Link",
   "label": "Content Order",
   "options": "Aqar Content Order"
  },
  {
   "fieldname": "retain_until",
   "fieldtype": "Date",
   "label": "Retain Until",
   "description": "Per the retention policy (customer input)."
  },
  {
   "fieldname": "checks_section",
   "fieldtype": "Section Break",
   "label": "Upload Checks"
  },
  {
   "fieldname": "scan_status",
   "fieldtype": "Select",
   "label": "Scan Status",
   "read_only": 1,
   "in_list_view": 1,
   "options": "Pending\nBasic Checks Passed\nClean (Antivirus)\nRejected"
  },
  {
   "fieldname": "sha256",
   "fieldtype": "Data",
   "label": "SHA-256",
   "read_only": 1
  },
  {
   "fieldname": "col_b",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "file_size",
   "fieldtype": "Int",
   "label": "Size (bytes)",
   "read_only": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  },
  {
   "role": "Aqar Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  },
  {
   "role": "Aqar Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  },
  {
   "role": "Aqar Team Lead",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  },
  {
   "role": "Aqar Opportunity Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  },
  {
   "role": "Aqar Business Development",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  },
  {
   "role": "Aqar Content Coordinator",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  },
  {
   "role": "Aqar Finance",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  }
 ]
}
